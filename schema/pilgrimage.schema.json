{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cdn.jsdelivr.net/gh/walktalkmeditate/open-pilgrimages@v1/schema/pilgrimage.schema.json",
  "title": "Pilgrimage Metadata",
  "description": "Route overview, tradition, cultural context, and logistics for a pilgrimage",
  "type": "object",
  "required": ["schemaVersion", "id", "lastUpdated", "name", "description", "overview", "tradition", "provenance"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Must match the directory name"
    },
    "parentRouteId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "For variants, references the parent route"
    },
    "metadataOnly": {
      "type": "string",
      "minLength": 1,
      "description": "Present only on a section that deliberately ships with no walked line, stages or waypoints, and says in one sentence why. A section that should have geometry and never got it is indistinguishable on disk from one that never can, so check-site exempts a section from the checks over geometry-derived files — route.gpx, the glyph, the roads corridor and the detail page's references to them — only where this declaration is present."
    },
    "lastUpdated": {
      "type": "string",
      "format": "date-time"
    },
    "name": { "$ref": "#/$defs/LocalizedString" },
    "description": { "$ref": "#/$defs/LocalizedString" },

    "overview": {
      "type": "object",
      "required": ["distanceKm", "estimatedDays", "topology", "startPoint", "difficulty"],
      "properties": {
        "distanceKm": { "type": "number", "minimum": 0 },
        "estimatedDays": {
          "type": "object",
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "integer", "minimum": 1 },
            "max": { "type": "integer", "minimum": 1 },
            "typical": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": true
        },
        "hoursNote": {
          "$ref": "#/$defs/LocalizedString",
          "description": "How each stage's estimatedHours was arrived at: the rule, the factor and where it was fitted, any choice the rule did not determine, and the published times the result was checked against. A reader has to be able to tell a derived figure from an asserted one."
        },
        "topology": {
          "type": "string",
          "enum": ["linear", "circular", "network"]
        },
        "direction": {
          "type": "string",
          "description": "Primary compass direction of travel"
        },
        "startPoint": { "$ref": "#/$defs/NamedLocation" },
        "endPoint": { "$ref": "#/$defs/NamedLocation" },
        "elevationRange": {
          "type": "object",
          "properties": {
            "minMeters": { "type": "number" },
            "maxMeters": { "type": "number" },
            "totalAscentMeters": { "type": "number", "minimum": 0 },
            "totalDescentMeters": { "type": "number", "minimum": 0 }
          },
          "additionalProperties": true
        },
        "difficulty": {
          "type": "string",
          "enum": ["easy", "moderate", "hard", "expert"]
        },
        "terrainTypes": {
          "type": "array",
          "items": { "$ref": "#/$defs/TerrainType" }
        },
        "bestMonths": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 12 }
        },
        "peakMonths": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 12 }
        },
        "countries": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Z]{2}$" }
        },
        "bbox": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4,
          "description": "[west, south, east, north]"
        }
      },
      "additionalProperties": true
    },

    "tradition": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["christian", "buddhist", "shinto", "multi-faith", "secular", "mixed"]
        },
        "primaryFaith": { "type": "string" },
        "otherFaiths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "saint": { "$ref": "#/$defs/LocalizedString" },
        "origin": { "$ref": "#/$defs/LocalizedString" },
        "unescoStatus": { "type": "string" },
        "unescoYear": { "type": "integer" },
        "credentialSystem": {
          "type": "object",
          "properties": {
            "name": { "$ref": "#/$defs/LocalizedString" },
            "description": { "$ref": "#/$defs/LocalizedString" },
            "completionCertificate": { "$ref": "#/$defs/LocalizedString" },
            "minimumDistanceKm": { "type": "number", "minimum": 0 },
            "minimumDistanceNote": { "$ref": "#/$defs/LocalizedString" },
            "obtainableAt": {
              "type": "array",
              "items": { "$ref": "#/$defs/NamedLocation" }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },

    "cultural": {
      "type": "object",
      "properties": {
        "practices": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "description"],
            "properties": {
              "name": { "$ref": "#/$defs/LocalizedString" },
              "description": { "$ref": "#/$defs/LocalizedString" },
              "location": {
                "type": "object",
                "properties": {
                  "coordinates": { "$ref": "#/$defs/Coordinates" },
                  "stageIndex": { "type": "integer", "minimum": 0 }
                },
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          }
        },
        "etiquette": {
          "type": "array",
          "items": { "$ref": "#/$defs/LocalizedString" }
        },
        "associatedLiterature": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "author"],
            "properties": {
              "title": { "type": "string" },
              "author": { "type": "string" },
              "isbn": { "type": "string" },
              "type": {
                "type": "string",
                "enum": ["memoir", "nonfiction", "poetry", "fiction", "guidebook"]
              },
              "relevance": { "$ref": "#/$defs/LocalizedString" }
            },
            "additionalProperties": true
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "$ref": "#/$defs/LocalizedString" },
              "date": {
                "type": "object",
                "properties": {
                  "month": { "type": "integer", "minimum": 1, "maximum": 12 },
                  "day": { "type": "integer", "minimum": 1, "maximum": 31 }
                },
                "additionalProperties": true
              },
              "recurrence": {
                "type": "string",
                "enum": ["annual", "monthly", "seasonal", "irregular"]
              },
              "description": { "$ref": "#/$defs/LocalizedString" }
            },
            "additionalProperties": true
          }
        },
        "historicalSignificance": { "$ref": "#/$defs/LocalizedString" }
      },
      "additionalProperties": true
    },

    "logistics": {
      "type": "object",
      "properties": {
        "seasonalAvailability": {
          "type": "object",
          "properties": {
            "openMonths": {
              "type": "array",
              "items": { "type": "integer", "minimum": 1, "maximum": 12 }
            },
            "notes": { "$ref": "#/$defs/LocalizedString" }
          },
          "additionalProperties": true
        },
        "accommodationTypes": {
          "type": "array",
          "items": { "$ref": "#/$defs/AccommodationType" }
        },
        "accommodationNotes": { "$ref": "#/$defs/LocalizedString" },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 currency code"
        },
        "languages": {
          "type": "array",
          "items": { "type": "string" }
        },
        "cellularCoverage": {
          "type": "string",
          "enum": ["excellent", "good", "fair", "poor", "none"]
        },
        "cellularNotes": { "$ref": "#/$defs/LocalizedString" },
        "waterAvailability": {
          "type": "string",
          "enum": ["abundant", "adequate", "limited", "scarce"]
        },
        "waterNotes": { "$ref": "#/$defs/LocalizedString" },
        "emergencyNumber": { "type": "string" },
        "transportLinks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "name"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["airport", "train", "bus", "ferry"]
              },
              "name": { "$ref": "#/$defs/LocalizedString" },
              "code": { "type": "string" },
              "nearStage": { "type": "integer" },
              "notes": { "$ref": "#/$defs/LocalizedString" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },

    "provenance": {
      "type": "object",
      "required": ["sources", "license"],
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "license", "dataTypes"],
            "properties": {
              "name": { "type": "string" },
              "url": { "type": "string", "format": "uri" },
              "license": { "type": "string" },
              "dataTypes": {
                "type": "array",
                "items": { "type": "string" }
              },
              "accessDate": {
                "type": "string",
                "format": "date"
              }
            },
            "additionalProperties": true
          }
        },
        "contributors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "role"],
            "properties": {
              "name": { "type": "string" },
              "role": { "type": "string" },
              "url": { "type": "string", "format": "uri" }
            },
            "additionalProperties": true
          }
        },
        "license": {
          "type": "string",
          "description": "License of the combined dataset. Must be ODbL-1.0 when OSM-derived data is included."
        }
      },
      "additionalProperties": true
    },

    "pilgrimage": {
      "type": "object",
      "required": ["id", "name", "kind", "order"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "$ref": "#/$defs/LocalizedString" },
        "kind": { "type": "string", "enum": ["legs", "alternatives"] },
        "order": { "type": "integer", "minimum": 1 },
        "circular": {
          "type": "boolean",
          "description": "The legs return to where they began, so the last section's final stage must close against the first section's first stage. A property of the whole walk: the sections it is made of are each linear."
        },
        "stats": {
          "type": "object",
          "required": ["lastUpdated", "dataYear", "dataNote", "annualPilgrims"],
          "properties": {
            "lastUpdated": {
              "type": "string",
              "format": "date",
              "description": "When these figures were last checked against their sources, which is not when the section's metadata last changed."
            },
            "dataYear": {
              "type": "integer",
              "description": "The most recent year the figures cover."
            },
            "dataNote": {
              "type": "string",
              "description": "How the counts were made and what they leave out. Required rather than optional: a whole-circuit figure published on a section's page is one a reader will otherwise take for that section's own."
            },
            "annualPilgrims": {
              "type": "object",
              "properties": {
                "latest": {
                  "type": "object",
                  "required": ["year", "count"],
                  "properties": {
                    "year": { "type": "integer" },
                    "count": { "type": "integer", "minimum": 0 },
                    "note": { "type": "string" }
                  },
                  "additionalProperties": true
                },
                "trend": { "$ref": "#/$defs/PilgrimTrend" },
                "walkingCompletions": { "$ref": "#/$defs/PilgrimSeries" },
                "cyclingCompletions": { "$ref": "#/$defs/PilgrimSeries" },
                "source": { "type": "string", "format": "uri" }
              },
              "additionalProperties": true
            },
            "demographics": { "type": "object" },
            "seasonalDistribution": { "type": "array" },
            "modeOfTravel": { "type": "array" },
            "infrastructure": { "type": "object" },
            "sources": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string" },
                  "url": { "type": "string", "format": "uri" },
                  "accessDate": { "type": "string", "format": "date" }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true,
          "description": "Counts and context measured over the whole walk. Every section of the pilgrimage repeats it and `validate` refuses sections that disagree, exactly as `name`, `kind` and `circular` are repeated — a pilgrimage has no directory of its own to hold a file. It is not a file either, so it carries neither a `schemaVersion` nor a `routeId`: `routes/{id}/stats.json` states one route's figures, and a figure measured over a circuit is no section's."
        }
      },
      "description": "The pilgrimage this section belongs to. Index-level only; a pilgrimage has no directory."
    },
    "osm": {
      "type": "object",
      "properties": {
        "relations": { "type": "array", "items": { "type": "integer" }, "minItems": 1 },
        "superroute": { "type": "integer" },
        "query": { "type": "string" },
        "note": {
          "type": "string",
          "description": "Why this relation list is what it is, where the choice is not obvious — a relation from a neighbouring section pinned so the line reaches its own end, a superroute preferred over its members, a spur left out."
        }
      },
      "description": "Relations are required for any section with a ways/ package; a name query alone pulls in spurs and variants."
    }
  },
  "additionalProperties": true,

  "$defs": {
    "LocalizedString": {
      "type": "object",
      "required": ["en"],
      "properties": {
        "en": { "type": "string" }
      },
      "additionalProperties": { "type": "string" }
    },
    "Coordinates": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 3,
      "description": "[longitude, latitude] or [longitude, latitude, altitude]"
    },
    "NamedLocation": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/LocalizedString" },
        "coordinates": { "$ref": "#/$defs/Coordinates" }
      },
      "additionalProperties": true
    },
    "PilgrimTrend": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["year", "count"],
        "properties": {
          "year": { "type": "integer" },
          "count": { "type": "integer", "minimum": 0 },
          "foreign": {
            "type": "integer",
            "minimum": 0,
            "description": "How many of that year's count came from outside the pilgrimage's own country."
          },
          "note": { "type": "string" }
        },
        "additionalProperties": true
      },
      "description": "One entry per year, in the order the years run."
    },
    "PilgrimSeries": {
      "type": "object",
      "required": ["trend"],
      "properties": {
        "trend": { "$ref": "#/$defs/PilgrimTrend" },
        "note": { "type": "string" },
        "cumulativeTotal": { "type": "integer", "minimum": 0 },
        "cumulativeTotalNote": {
          "type": "string",
          "description": "Why the sum of the trend is not the total the source publishes, where the two differ."
        },
        "cumulativeForeign": { "type": "integer", "minimum": 0 },
        "source": { "type": "string", "format": "uri" }
      },
      "additionalProperties": true,
      "description": "A year series counted one way — on foot, by bicycle — where a pilgrimage counts each mode separately."
    },
    "TerrainType": {
      "type": "string",
      "enum": ["paved", "gravel", "dirt", "cobblestone", "mountain", "forest", "coastal", "urban", "sand", "rock", "boardwalk"]
    },
    "AccommodationType": {
      "type": "string",
      "enum": ["albergue", "hotel", "pension", "casa_rural", "camping", "temple_lodging", "ryokan", "minshuku", "hut", "hostel", "bivouac"]
    }
  }
}
