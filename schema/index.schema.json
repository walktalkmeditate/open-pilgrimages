{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cdn.jsdelivr.net/gh/walktalkmeditate/open-pilgrimages@v1/schema/index.schema.json",
  "title": "Open Pilgrimages Route Index",
  "description": "Registry of all pilgrimage routes in the dataset",
  "type": "object",
  "required": ["schemaVersion", "release", "generatedAt", "routes"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "SemVer schema version"
    },
    "release": {
      "type": "string",
      "pattern": "^v\\d+\\.\\d+\\.\\d+$",
      "description": "The git tag this build will be released under. The app pins every package download to it."
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of generation"
    },
    "pilgrimages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "sections"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "$ref": "#/$defs/LocalizedString" },
          "kind": { "type": "string", "enum": ["legs", "alternatives"] },
          "sections": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "distanceKm": { "type": "number", "minimum": 0 },
          "stageCount": { "type": "integer", "minimum": 0 },
          "stats": {
            "type": "object",
            "required": ["lastUpdated", "dataYear", "dataNote"],
            "properties": {
              "lastUpdated": { "type": "string", "format": "date" },
              "dataYear": { "type": "integer" },
              "dataNote": { "type": "string" },
              "annualPilgrims": {
                "type": "object",
                "required": ["latest"],
                "properties": {
                  "latest": {
                    "type": "object",
                    "required": ["year", "count"],
                    "properties": {
                      "year": { "type": "integer" },
                      "count": { "type": "integer", "minimum": 0 },
                      "note": { "type": "string" }
                    },
                    "additionalProperties": true
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false,
            "description": "A summary of the whole-walk figures the pilgrimage's sections carry, so a consumer can see that they exist and how current they are without fetching a section. Absent for a pilgrimage whose sections carry none. The year series, demographics and infrastructure are deliberately not here: `additionalProperties: false` is what keeps them out, because index.json is the one file every consumer downloads from @main and a hundred lines of trend data is not a summary. `pilgrimage.schema.json` states the full block, every section repeats it, and `validate` refuses sections that disagree."
          }
        }
      }
    },
    "routes": {
      "type": "array",
      "items": { "$ref": "#/$defs/RouteEntry" }
    }
  },
  "$defs": {
    "LocalizedString": {
      "type": "object",
      "required": ["en"],
      "properties": {
        "en": { "type": "string" }
      },
      "additionalProperties": { "type": "string" },
      "description": "Localized string keyed by BCP 47 language tag. English required."
    },
    "RouteEntry": {
      "type": "object",
      "required": ["id", "name", "region", "country", "distanceKm", "topology", "tradition", "path"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "Stable kebab-case route identifier"
        },
        "name": { "$ref": "#/$defs/LocalizedString" },
        "region": {
          "type": "string",
          "enum": ["Europe", "Asia", "Americas", "Africa", "Oceania", "Middle East"]
        },
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$",
          "description": "ISO 3166-1 alpha-2 country code"
        },
        "distanceKm": {
          "type": "number",
          "minimum": 0
        },
        "topology": {
          "type": "string",
          "enum": ["linear", "circular", "network"]
        },
        "tradition": {
          "type": "string",
          "enum": ["christian", "buddhist", "shinto", "multi-faith", "secular", "mixed"]
        },
        "path": {
          "type": "string",
          "description": "Relative path from repo root to route directory"
        },
        "pilgrimage": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "variants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "distanceKm", "path"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "name": { "$ref": "#/$defs/LocalizedString" },
              "distanceKm": {
                "type": "number",
                "minimum": 0
              },
              "path": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "ways": {
          "type": "object",
          "required": ["stageCount", "bytes", "placesPerStage", "sparse"],
          "description": "Present only when every stage of the route's package cleared the length gate. Absent means the app hides the route. `sparse` is true when fewer than half the stages carry a place beyond the day's own start and end, and the app's card says so.",
          "properties": {
            "stageCount": { "type": "integer", "minimum": 1, "maximum": 200 },
            "bytes": { "type": "integer", "minimum": 1, "maximum": 52428800 },
            "placesPerStage": { "type": "number", "minimum": 0, "maximum": 200 },
            "sparse": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
