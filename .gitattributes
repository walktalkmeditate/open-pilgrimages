# Every route.gpx is one <trkpt> line per point (see scripts/site/gpx.ts) —
# any regeneration is a whole-file diff, up to ~1.5 MB for camino-norte, that
# renders unusably on GitHub. It's build output of route.geojson, not
# something anyone reviews line by line.
*.gpx linguist-generated
*.gpx -diff
routes/*/route.main.geojson -diff linguist-generated
